# EventIQ environment variables
# Copy this file to .env (git-ignored) and fill in the values: cp .env.example .env
# The same .env is read by Spring Boot, the Python service and Docker Compose.
#
# Format: KEY=value on one line. No quotes, no spaces around "=", no comments after a value.
# Spring Boot reads this file as .properties, so quotes and trailing comments would become
# part of the value; also avoid backslashes (\).

# Oracle Database Free admin password (only used to create the container)
ORACLE_PWD=<admin_password>

# Database user the applications connect as (see README: create user and schema)
DB_USER=app_user
DB_PASSWORD=<app_password>

# Password of the application's admin user (form login and POST /api/auth/login)
ADMIN_PASSWORD=<app_login_password>

# HS256 key that signs and validates JWTs: at least 32 random characters
# Generate one with: openssl rand -hex 32
JWT_SECRET=<at_least_32_random_characters>

# Gemini API key from Google AI Studio: https://aistudio.google.com
AI_API_KEY=<gemini_api_key>

# Optional overrides; the defaults below apply when these stay commented out
# AI_MODEL=gemini-2.5-flash
# DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
# DB_DSN=localhost:1521/FREEPDB1
# ANALYTICS_URL=http://localhost:8000
